<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <LongPathAware>true</LongPathAware>
    <RootNamespace>文件整理助手</RootNamespace>
    <AssemblyName>文件整理助手</AssemblyName>
    <AssemblyTitle>文件整理助手</AssemblyTitle>
    <Version>2.2.0</Version>
    <FileVersion>2.2.0.0</FileVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="SharpCompress" Version="0.38.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ui\index.html" />
  </ItemGroup>

  <Target Name="RemoveUnneededWebView2Documentation" AfterTargets="Publish">
    <ItemGroup>
      <UnneededPublishFile Include="$(PublishDir)Microsoft.Web.WebView2.*.xml" />
    </ItemGroup>
    <Delete Files="@(UnneededPublishFile)" />
  </Target>

</Project>
